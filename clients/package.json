{
  "name": "shpherd-clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @shpherd/ui dev",
    "build": "pnpm --filter @shpherd/ui build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "tauri:dev": "pnpm --filter @shpherd/tauri dev",
    "tauri:debug": "pnpm --filter @shpherd/tauri build:debug",
    "tauri:fmt": "cargo fmt --manifest-path apps/shpherd-tauri/src-tauri/Cargo.toml --check",
    "tauri:check": "cargo check --locked --manifest-path apps/shpherd-tauri/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
